---
import "../styles/main.css";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Manuel Causil — Desarrollador Full Stack",
  description = "Ingeniero de Sistemas y desarrollador full stack. Catorce plataformas para clientes reales: rastreo satelital, domótica, gestión de pedidos y sitios corporativos.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://manuelc14.github.io/");
const ogImage = new URL("/images/og.png", Astro.site ?? "https://manuelc14.github.io/");

// Datos estructurados: es lo que permite que un buscador entienda que
// esta página describe a una persona, no a un producto.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Manuel Causil",
  jobTitle: "Desarrollador Full Stack",
  url: canonical.href,
  image: ogImage.href,
  email: "mailto:ignas.manuel@hotmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Yopal",
    addressRegion: "Casanare",
    addressCountry: "CO",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Corporación Universitaria Remington",
  },
  worksFor: { "@type": "Organization", name: "InnovaMC", url: "https://innovamc.com" },
  sameAs: ["https://github.com/Manuelc14", "https://www.linkedin.com/in/manuel-causil-a48454267/"],
  knowsAbout: [
    "JavaScript",
    "TypeScript",
    "React",
    "Vue",
    "Astro",
    "Django",
    "Laravel",
    "PostgreSQL",
  ],
};
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Solo se precarga lo que bloquea la primera pintura: la tipografía
         del cuerpo y el retrato del héroe (el elemento LCP). Precargar de
         más haría competir los recursos entre sí y sería contraproducente. -->
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <!-- El retrato ya no se precarga a mano: lo genera `astro:assets` con
         nombre con hash, y va con loading="eager" + fetchpriority="high",
         que el navegador prioriza igual. -->

    <meta name="theme-color" content="#0b1220" />

    <script is:inline>
      // Antes de pintar: fija el tema y quita `no-js`. El sitio arranca en
      // oscuro; solo se pone claro si el visitante lo eligió antes.
      (() => {
        document.documentElement.classList.remove("no-js");
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (_) {
          /* modo privado: seguimos con el tema por defecto */
        }
        const theme = stored === "light" ? "light" : "dark";
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.classList.toggle("dark-mode", theme === "dark");
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <IconSprite />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/app.js";
      import "../scripts/i18n.js";
    </script>
  </body>
</html>
