---
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

// Cifras derivadas de la colección, no escritas a mano: si se añade un
// proyecto, se actualizan solas y siguen siendo ciertas.
const projectCount = projects.length;
const liveCount = projects.filter((p) => Boolean(p.data.url)).length;
const years = projects.map((p) => p.data.year);
const yearSpan = Math.max(...years) - Math.min(...years) + 1;

const social = [
  {
    href: "https://www.linkedin.com/in/manuel-causil-a48454267/",
    icon: "linkedin",
    label: "LinkedIn",
  },
  { href: "https://github.com/Manuelc14", icon: "github", label: "GitHub" },
];
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__grid">
      <div class="hero__content">
        <p class="pill-status" data-i18n="hero.available">Disponible para nuevos proyectos</p>

        <h1 id="hero-title" class="hero__title">
          <span data-i18n="hero.hi">Hola, soy</span>
          <span class="accent">Manuel Causil</span>
        </h1>

        <p class="hero__role" data-i18n="hero.role">Ingeniero de Sistemas</p>

        <p class="hero__lead" data-i18n="hero.lead">
          Diseño y desarrollo productos rápidos, accesibles y mantenibles.
        </p>

        <p class="hero__stack" data-i18n="hero.stack" data-i18n-html>
          Stack favorito: <strong>React</strong>, <strong>Vue</strong>,
          <strong>Django</strong>, <strong>Laravel</strong>.
        </p>

        <div class="hero__cta" role="group" aria-label="Acciones principales">
          <a class="btn btn--primary" href="#portfolio">
            <Icon name="layers" />
            <span data-i18n="hero.cta.projects">Ver proyectos</span>
          </a>
          <a class="btn btn--gold" href="/cv.pdf" download="Manuel-Causil-CV">
            <Icon name="download" />
            <span data-i18n="hero.cta.download">Descargar CV</span>
          </a>
          <a class="btn btn--ghost" href="#contact">
            <Icon name="mail" />
            <span data-i18n="hero.cta.contact">Contactar</span>
          </a>
        </div>

        <ul class="hero__social" aria-label="Redes sociales">
          {
            social.map((s) => (
              <li>
                <a
                  class="btn-icon"
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  title={s.label}
                >
                  <Icon name={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__media">
        <div class="figure-stage" data-hero-figure aria-hidden="true">
          <!-- Compacto y a propósito: un mockup de teléfono, no una ventana
               de escritorio ocupando media columna. -->
          <div class="phone" data-depth="6">
            <span class="phone__notch"></span>

            <div class="phone__screen">
              <div class="phone__status">
                <span class="phone__status-live"><i></i>Live</span>
                <span class="phone__signal" aria-hidden="true">
                  <i></i><i></i><i></i>
                </span>
              </div>

              <div class="phone__stage">
                <span class="phone__ring phone__ring--a"></span>
                <span class="phone__ring phone__ring--b"></span>

                <div class="phone__core">
                  <span class="phone__core-pulse"></span>
                  <Icon name="code" />
                </div>
              </div>

              <p class="phone__code">
                <span class="phone__code-kw">const</span> dev = <span class="phone__code-str"
                  >"Manuel Causil"</span
                ><span class="phone__cursor"></span>
              </p>
            </div>
          </div>

          <div class="figure-chip" style="--top:1%; --left:-8%;" data-depth="18">
            <div class="figure-chip__inner" style="--delay:0s">
              <span class="icon-badge icon-badge--sm"><Icon name="code" /></span>
              <div>
                <strong>Frontend</strong>
                <span>React · Vue</span>
              </div>
            </div>
          </div>

          <div class="figure-chip" style="--top:1%; --left:84%;" data-depth="14">
            <div class="figure-chip__inner" style="--delay:.6s">
              <span class="icon-badge icon-badge--sm"><Icon name="workflow" /></span>
              <div>
                <strong>Backend</strong>
                <span>Laravel · Django</span>
              </div>
            </div>
          </div>

          <div
            class="figure-chip figure-chip--secondary"
            style="--top:44%; --left:-14%;"
            data-depth="10"
          >
            <div class="figure-chip__inner" style="--delay:1.1s">
              <span class="icon-badge icon-badge--sm"><Icon name="database" /></span>
              <div>
                <strong data-i18n="hero.figure.data">Bases de datos</strong>
                <span>PostgreSQL</span>
              </div>
            </div>
          </div>

          <div class="figure-chip" style="--top:44%; --left:90%;" data-depth="16">
            <div class="figure-chip__inner" style="--delay:.3s">
              <span class="icon-badge icon-badge--sm"><Icon name="bolt" /></span>
              <div>
                <strong data-i18n="hero.figure.automation">Automatización</strong>
                <span>Power BI</span>
              </div>
            </div>
          </div>

          <div class="figure-chip" style="--top:88%; --left:-19%;" data-depth="12">
            <div class="figure-chip__inner" style="--delay:.9s">
              <span class="icon-badge icon-badge--sm icon-badge--gold"
                ><Icon name="briefcase" /></span
              >
              <div>
                <strong class="stat-shine" data-counter={projectCount}>{projectCount}</strong>
                <span data-i18n="hero.figure.live">Proyectos en producción</span>
              </div>
            </div>
          </div>

          <div
            class="figure-chip figure-chip--secondary"
            style="--top:88%; --left:84%;"
            data-depth="20"
          >
            <div class="figure-chip__inner" style="--delay:1.4s">
              <span class="icon-badge icon-badge--sm"><Icon name="check" /></span>
              <div>
                <strong>APIs REST</strong>
                <span data-i18n="hero.figure.api_sub">Integraciones</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__stats">
      <div class="hero__stat">
        <strong class="stat-shine" data-counter={projectCount}>{projectCount}</strong>
        <span data-i18n="hero.stats.delivered">Proyectos entregados</span>
      </div>
      <div class="hero__stat">
        <strong class="stat-shine" data-counter={liveCount}>{liveCount}</strong>
        <span data-i18n="hero.stats.live">En producción</span>
      </div>
      <div class="hero__stat">
        <strong class="stat-shine" data-counter={yearSpan}>{yearSpan}</strong>
        <span data-i18n="hero.stats.years">Años entregando</span>
      </div>
      <div class="hero__stat">
        <strong class="stat-shine" data-counter="2">2</strong>
        <span data-i18n="hero.stats.languages">Idiomas del sitio</span>
      </div>
    </div>
  </div>
</section>
