---
import Icon from "./Icon.astro";

// Los textos viven en las traducciones (testimonials.items.<slug>.*).
// Aquí se rinden en español y `data-i18n` los cambia al inglés.
const items = [
  {
    slug: "gcltracs",
    company: "GCLTracs",
    person: "Germán Cruz",
    role: "Director",
    text: "Solo quería decir que estoy feliz con mi nuevo sitio web. Fueron rápidos en actuar y, como resultado, aumentaron las consultas y las ventas de mis servicios.",
  },
  {
    slug: "solon-soluciones",
    company: "Solon Soluciones",
    person: "Carlos Ortiz",
    role: "CEO",
    text: "El sitio con Astro quedó veloz y ligero. Mejoró la visibilidad del portafolio y recibimos más contactos de obra. Excelente criterio técnico y de SEO.",
  },
  {
    slug: "aquacontrol",
    company: "AquaControl",
    person: "Yury Amaya",
    role: "Administradora",
    text: "La plataforma nos permitió organizar pedidos y clientes en un solo lugar. La carga es rápida, el panel es claro y el soporte ha sido oportuno en cada ajuste.",
  },
  {
    slug: "nitt",
    company: "Nitt",
    person: "Erick Velásquez",
    role: "Gerente",
    text: "Lanzamos una web clara y fácil de navegar. En poco tiempo empezamos a recibir más cotizaciones y ahora el mantenimiento es mucho más simple.",
  },
  {
    slug: "iqhome",
    company: "iQHome",
    person: "Edwin Hernández",
    role: "Director",
    text: "Tradujeron exactamente lo que necesitábamos: un sitio moderno para domótica, con enfoque en innovación y resultados. Comunicación fluida y entregas a tiempo.",
  },
  {
    slug: "cea-dizcar",
    company: "CEA Dizcar",
    person: "José Díaz Barrera",
    role: "Dueño",
    text: "La web explica mejor nuestros cursos y facilita la inscripción. Se nota el enfoque en SEO: más visitas y más llamadas desde el sitio.",
  },
  {
    slug: "casalup-services",
    company: "Casalup Services",
    person: "Carlos Gutierrez",
    role: "Gerente",
    text: "Quedó un sitio limpio y orientado a conversión. El formulario de contacto y el posicionamiento nos trajeron más eventos y cotizaciones.",
  },
  {
    slug: "innova-energy",
    company: "Innova-energy",
    person: "Óscar Iván Carrero",
    role: "Director",
    text: "El diseño a medida refleja mejor nuestros servicios de ingeniería. Mejoraron tiempos de carga y estamos recibiendo más consultas orgánicas.",
  },
];

const initials = (name: string) =>
  name
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
---

<section id="testimonials" class="section section--alt">
  <div class="container">
    <div class="section__head section__head--center">
      <p class="section__kicker">Clientes</p>
      <h2 class="section__title" data-i18n="testimonials.title" data-i18n-html>
        Testimonios <span>Valiosos</span>
      </h2>
      <p class="section__lead" data-i18n="testimonials.subtitle">
        Lo que opinan mis clientes después de trabajar juntos
      </p>
    </div>

    <div
      class="testimonials__viewport"
      data-carousel
      tabindex="0"
      role="region"
      aria-label="Carrusel de testimonios"
      data-i18n-attr="aria-label:testimonials.a11y.carousel"
    >
      {
        items.map((t) => (
          <figure class="card testimonial">
            <blockquote class="testimonial__quote" data-i18n={`testimonials.items.${t.slug}.text`}>
              {t.text}
            </blockquote>
            <figcaption class="testimonial__author">
              <span class="testimonial__avatar" aria-hidden="true">
                {initials(t.person)}
              </span>
              <div>
                <p class="testimonial__name" data-i18n={`testimonials.items.${t.slug}.person`}>
                  {t.person}
                </p>
                <p class="testimonial__role">
                  <span data-i18n={`testimonials.items.${t.slug}.role`}>{t.role}</span>
                  {" · "}
                  <span data-i18n={`testimonials.items.${t.slug}.company`}>{t.company}</span>
                </p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="testimonials__controls">
      <div
        class="testimonials__dots"
        data-carousel-dots
        role="tablist"
        aria-label="Paginación de testimonios"
        data-i18n-attr="aria-label:testimonials.a11y.pagination"
      >
      </div>
      <button
        type="button"
        class="btn-icon"
        data-carousel-prev
        aria-label="Testimonio anterior"
        data-i18n-attr="aria-label:testimonials.a11y.prev"
      >
        <Icon name="chevron-left" />
      </button>
      <button
        type="button"
        class="btn-icon"
        data-carousel-next
        aria-label="Siguiente testimonio"
        data-i18n-attr="aria-label:testimonials.a11y.next"
      >
        <Icon name="chevron-right" />
      </button>
    </div>
  </div>
</section>
