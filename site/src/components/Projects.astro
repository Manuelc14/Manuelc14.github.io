---
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";

// Icono y sector por proyecto: un dato más que la tarjeta puede mostrar
// sin exigir una captura de 9 MB. Cada icono alude a lo que hace el
// proyecto, no a la tecnología.
const meta: Record<string, { icon: string; sector?: string }> = {
  aquacontrol: { icon: "droplet", sector: "Gestión de pedidos" },
  "casalup-services": { icon: "utensils", sector: "Catering" },
  "cea-dizcar": { icon: "car", sector: "Enseñanza automovilística" },
  gcltracs: { icon: "satellite", sector: "Rastreo satelital" },
  "innova-energy": { icon: "bolt", sector: "Ingeniería" },
  innovamc: { icon: "layers", sector: "Tecnología" },
  iqhome: { icon: "home", sector: "Domótica" },
  nitt: { icon: "sparkle", sector: "Servicios de limpieza" },
  "solon-soluciones": { icon: "building", sector: "Construcción" },
  // Proyectos nuevos: el sector real vive en el frontmatter (data.sector);
  // acá solo hace falta el icono.
  prosvial: { icon: "check" },
  intecor: { icon: "graduation" },
  progesst: { icon: "briefcase" },
  "casa-tsintani": { icon: "brain" },
  "innovamc-panel": { icon: "workflow" },
};

// object-fit:contain llena por completo el eje más alto del logo dentro del
// chip cuadrado, así que un logo más vertical que ancho queda pegado arriba
// y abajo sin margen visible. Solo aquacontrol y casa-tsintani son así de
// verticales — el resto ya se ve centrado con espacio de sobra. Reescala esa
// figura (ver `--logo-scale` en projects.css) sin tocar nada más.
const LOGO_SCALE: Record<string, number> = {
  aquacontrol: 0.72,
  "casa-tsintani": 0.72,
};

// Orden editorial: los proyectos con backend propio, roles/autenticación o
// lógica de negocio real primero (los que mejor argumentan nivel técnico),
// el resto queda detrás del botón "Ver más" — sin ocultarlos, solo un clic
// más lejos. Ver plan-portafolio-manuel-causil.md para el criterio completo.
const FEATURED_ORDER = [
  "aquacontrol",
  "intecor",
  "progesst",
  "gcltracs",
  "innovamc-panel",
  "casa-tsintani",
];

const bySlug = (entry: { id: string }) => entry.id.replace(/^projects\//, "").replace(/\.md$/, "");

const allItems = await getCollection("projects");
const featured = FEATURED_ORDER.map((slug) => allItems.find((it) => bySlug(it) === slug)).filter(
  (it): it is NonNullable<typeof it> => Boolean(it)
);
const rest = allItems
  .filter((it) => !FEATURED_ORDER.includes(bySlug(it)))
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0));

const items = [...featured, ...rest];
const featuredCount = featured.length;
---

<section id="portfolio" class="section section--alt">
  <div class="container">
    <div class="section__head section__head--center reveal">
      <p class="section__kicker">Portafolio</p>
      <h2 class="section__title" data-i18n="portfolio.title" data-i18n-html>
        Últimos <span>Proyectos</span>
      </h2>
      <p class="section__lead" data-i18n="portfolio.desc">
        A continuación puede ver o visitar cualquiera de los proyectos realizados
      </p>
    </div>

    <div class="projects__grid" data-projects-grid>
      {
        items.map(({ id, data }, idx) => {
          const slug = id.replace(/^projects\//, "").replace(/\.md$/, "");
          const m = meta[slug] ?? { icon: "layers" };
          const sector = data.sector ?? m.sector ?? "Proyecto web";
          const isExtra = idx >= featuredCount;
          return (
            <article
              class={`card card--hover project reveal${isExtra ? " project--extra" : ""}`}
              style={`--stagger:${idx % 3}`}
            >
              <div class="project__head">
                {data.logo ? (
                  <span
                    class={`project__mark project__mark--logo${
                      LOGO_SCALE[slug] ? " project__mark--tallfix" : ""
                    }`}
                  >
                    <img
                      src={data.logo}
                      alt={`Logo de ${data.title}`}
                      width="72"
                      height="72"
                      loading="lazy"
                      decoding="async"
                      style={LOGO_SCALE[slug] ? `--logo-scale:${LOGO_SCALE[slug]}` : undefined}
                    />
                  </span>
                ) : (
                  <span class="project__mark">
                    <Icon name={m.icon} />
                  </span>
                )}
                <div>
                  <h3 class="project__name" data-i18n={`projects.${slug}.title`}>
                    {data.title}
                  </h3>
                  <p class="project__meta">
                    {data.year} · {sector}
                  </p>
                </div>
                {data.url && (
                  <span class="project__link" aria-hidden="true">
                    <Icon name="external" />
                  </span>
                )}
              </div>

              {data.status && <span class="pill-status">{data.status}</span>}

              <p class="project__desc" data-i18n={`projects.${slug}.description`}>
                {data.description}
              </p>

              {data.highlights && data.highlights.length > 0 && (
                <ul class="project__facts">
                  {data.highlights.map((h) => (
                    <li class="project__fact">
                      <Icon name="check" />
                      {h}
                    </li>
                  ))}
                </ul>
              )}

              <div class="chip-row">
                {data.stack.map((s) => (
                  <span class="chip">{s}</span>
                ))}
              </div>

              {data.serviceUrl && (
                <a
                  class="project__service"
                  href={data.serviceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Ver servicio
                  <Icon name="arrow-right" />
                </a>
              )}

              {data.url && (
                <a class="project__cover" href={data.url} target="_blank" rel="noopener noreferrer">
                  <span class="sr-only">Abrir {data.title} en una pestaña nueva</span>
                </a>
              )}
            </article>
          );
        })
      }
    </div>

    {
      rest.length > 0 && (
        <div class="projects__more-wrap">
          <button
            type="button"
            class="btn btn--ghost projects__more-btn"
            data-projects-toggle
            aria-expanded="false"
          >
            <span data-i18n="portfolio.show_more">Ver más proyectos</span>
            <Icon name="chevron-right" class="icon-more" />
          </button>
        </div>
      )
    }
  </div>
</section>
