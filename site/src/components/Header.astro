---
import Icon from "./Icon.astro";

// El texto va renderizado en el HTML (no vacío esperando a i18next):
// así existe para Google y para quien navegue sin JS. Los `data-i18n`
// solo lo REEMPLAZAN al cambiar a inglés.
const links = [
  { href: "#home", key: "home", label: "Inicio" },
  { href: "#about", key: "about", label: "Sobre mí" },
  { href: "#skills", key: "skills", label: "Habilidades" },
  { href: "#portfolio", key: "portfolio", label: "Proyectos" },
  { href: "#experience", key: "experience", label: "Experiencia" },
  { href: "#education", key: "education", label: "Formación" },
  { href: "#contact", key: "contact", label: "Contacto" },
];
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="brand" href="#home">
      <span class="brand__mark">
        <img src="/images/logo.png" width="36" height="36" loading="eager" alt="" />
      </span>
      <span class="brand__text">
        <strong>Manuel Causil</strong>
        <small>Full Stack</small>
      </span>
    </a>

    <nav class="nav" id="nav" data-nav aria-label="Navegación principal">
      {
        links.map((l) => (
          <a class="nav__link" href={l.href} data-i18n={`header.nav.${l.key}`}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header__tools">
      <button
        type="button"
        class="btn-icon theme-btn"
        data-theme-toggle
        title="Cambiar tema"
        aria-label="Cambiar tema"
        data-i18n-attr="title:header.theme; aria-label:header.theme"
      >
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>

      <button
        type="button"
        class="btn-icon lang-btn"
        data-lang-toggle
        title="Cambiar idioma"
        aria-label="Cambiar idioma"
        data-i18n-attr="aria-label:header.lang.aria"
      >
        <span data-lang-label>ES</span>
      </button>

      <button
        type="button"
        class="btn-icon nav-toggle"
        data-nav-toggle
        aria-controls="nav"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" style="display:none" />
      </button>
    </div>
  </div>

  <div class="nav__backdrop" data-nav-backdrop hidden></div>
</header>
