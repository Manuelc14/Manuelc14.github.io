---
import Icon from "./Icon.astro";

const meters = [
  { key: "skills.highlight_js", label: "JavaScript / TypeScript", p: 85 },
  { key: "skills.highlight_py", label: "Python / Django", p: 80 },
  { key: "skills.highlight_php", label: "PHP / Laravel", p: 78 },
  { key: "skills.highlight_sql", label: "SQL y Optimización", p: 82 },
];

const groups = [
  {
    icon: "code",
    titleKey: "skills.tech",
    title: "Tecnologías",
    prefix: "skills.tech_",
    items: [
      "JavaScript / TypeScript (Angular, Vue, React)",
      "PHP (Laravel)",
      "Python (Django, DRF)",
      "HTML, CSS, Responsive",
      "SQL (MySQL / PostgreSQL)",
    ],
  },
  {
    icon: "users",
    titleKey: "skills.pro",
    title: "Profesionales",
    prefix: "skills.pro_",
    items: [
      "Diseño UI/UX",
      "Desarrollo de Software",
      "Testing",
      "Comunicación y trabajo en equipo",
      "Consultoría y digitalización",
    ],
  },
  {
    icon: "briefcase",
    titleKey: "skills.backend_title",
    title: "Backend & Paneles Admin",
    prefix: "skills.backend_",
    items: [
      "Laravel + Livewire + Alpine.js",
      "Filament (paneles admin) + Spatie Permission (roles y permisos)",
      "Autenticación reforzada: Breeze, Fortify (2FA)",
      "Generación de PDF y certificados (DomPDF)",
      "Inertia.js + React + TypeScript (SPA sin API separada)",
    ],
  },
  {
    icon: "database",
    titleKey: "skills.db_title",
    title: "Bases de Datos & Automatización",
    prefix: "skills.db_",
    items: [
      "Modelado relacional, normalización e índices",
      "Migraciones y ORM (Eloquent, Django ORM)",
      "Apps de escritorio con datos (Electron + PyInstaller)",
      "Python para datos: pandas, Altair, dashboards",
      "Automatización con OCR (Tesseract, Poppler)",
      "Backups, seeds y diseño de esquemas para reporting",
    ],
  },
  {
    icon: "tools",
    titleKey: "skills.tools_title",
    title: "Metodologías & DevOps",
    prefix: "skills.tools_",
    items: [
      "Scrum / Kanban · GitFlow · Code Reviews",
      "CI/CD (GitHub Actions) · Docker",
      "Patrones, SOLID, Clean Code, TDD",
      "Git, GitHub · Node.js · Vite · Astro",
      "Despliegue: Nginx, hosting compartido (SSH, cPanel), PowerShell",
      "Desarrollo asistido por IA (Claude Code, contexto de proyecto estructurado)",
    ],
  },
  {
    icon: "brain",
    titleKey: "skills.logic_title",
    title: "Lógica & Resolución de Problemas",
    prefix: "skills.logic_",
    items: [
      "Descomposición y diseño incremental",
      "Debugging sistemático",
      "Optimización de performance",
      "Diseño de APIs claras",
      "Automatización de tareas repetitivas",
    ],
  },
];
---

<section id="skills" class="section">
  <div class="container">
    <div class="section__head section__head--center reveal">
      <p class="section__kicker">Stack</p>
      <h2 class="section__title" data-i18n="skills.title" data-i18n-html>
        Mis <span>Habilidades</span>
      </h2>
    </div>

    <div class="skills__meters reveal">
      {
        meters.map((m) => (
          <div class="meter">
            <div class="meter__head">
              <span class="meter__label" data-i18n={m.key}>
                {m.label}
              </span>
              <span class="meter__value">{m.p}%</span>
            </div>
            <div
              class="meter__track"
              role="progressbar"
              aria-valuenow={m.p}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-label={m.label}
            >
              <div class="meter__fill" style={`--p:${m.p}`} />
            </div>
          </div>
        ))
      }
    </div>

    <div class="skills__grid">
      {
        groups.map((g, gi) => (
          <article class="card card--hover skill-card reveal" style={`--stagger:${gi}`}>
            <div class="skill-card__head">
              <span class="icon-badge">
                <Icon name={g.icon} />
              </span>
              <h3 class="skill-card__title" data-i18n={g.titleKey}>
                {g.title}
              </h3>
            </div>
            <ul class="skill-card__list">
              {g.items.map((it, i) => (
                <li data-i18n={`${g.prefix}${i + 1}`}>{it}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
