---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import meAbout from "../assets/img/meabout.png";

const points = [
  { key: "about.item_1", text: "Arquitecturas simples y mantenibles." },
  { key: "about.item_2", text: "Buenas prácticas: a11y, SEO técnico, performance." },
  { key: "about.item_3", text: "Entrega continua y documentación clara." },
];
---

<section id="about" class="section section--alt">
  <div class="container">
    <div class="about__grid">
      <div class="about__media reveal">
        <Image
          src={meAbout}
          widths={[420, 640, 900]}
          sizes="(max-width: 768px) 90vw, 34vw"
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
          alt="Manuel Causil trabajando"
        />
      </div>

      <div class="about__body reveal" style="--stagger:1">
        <p class="section__kicker" data-i18n="about.kicker">Sobre mí</p>

        <h2 class="about__title" data-i18n="about.title">
          Full-Stack Developer enfocado en producto, performance y UX
        </h2>

        <p class="about__lead" data-i18n="about.lead">
          Diseñador y desarrollador de soluciones web y escritorio.
        </p>

        <ul class="list-check">
          {
            points.map((p) => (
              <li>
                <Icon name="check" />
                <span data-i18n={p.key}>{p.text}</span>
              </li>
            ))
          }
        </ul>

        <div class="chip-row">
          <span class="chip" data-i18n="about.pill_years">+5 años</span>
          <span class="chip" data-i18n="about.pill_stack">Full-Stack</span>
        </div>
      </div>
    </div>
  </div>
</section>
