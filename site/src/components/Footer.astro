---
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy" data-i18n="footer.copy" data-i18n-params={JSON.stringify({ year })}>
      © {year} Manuel Causil | Todos los derechos reservados
    </p>

    <ul class="footer__social">
      <li>
        <a
          class="btn-icon"
          href="https://www.linkedin.com/in/manuel-causil-a48454267/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" />
        </a>
      </li>
      <li>
        <a
          class="btn-icon"
          href="https://github.com/Manuelc14"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <Icon name="github" />
        </a>
      </li>
    </ul>
  </div>
</footer>

<button
  type="button"
  class="btn-icon to-top"
  data-to-top
  aria-label="Volver arriba"
  data-i18n-attr="aria-label:footer.to_top"
>
  <Icon name="arrow-up" />
</button>
