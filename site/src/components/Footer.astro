---
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

// wa.me exige el número en formato internacional, sin + ni espacios.
const WHATSAPP = "573134096201";
const waText = encodeURIComponent(
  "Hola Manuel, vi tu portafolio y quiero consultarte un proyecto."
);
const waHref = `https://wa.me/${WHATSAPP}?text=${waText}`;
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy" data-i18n="footer.copy" data-i18n-params={JSON.stringify({ year })}>
      © {year} Manuel Causil | Todos los derechos reservados
    </p>

    <ul class="footer__social">
      <li>
        <a
          class="btn-icon"
          href="https://www.linkedin.com/in/manuel-causil-a48454267/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" />
        </a>
      </li>
      <li>
        <a
          class="btn-icon"
          href="https://github.com/Manuelc14"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <Icon name="github" />
        </a>
      </li>
    </ul>
  </div>
</footer>

<a
  class="btn-icon wa-fab"
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  title="Escribir por WhatsApp"
  data-i18n-attr="aria-label:footer.whatsapp; title:footer.whatsapp"
>
  <Icon name="whatsapp" />
</a>

<button
  type="button"
  class="btn-icon to-top"
  data-to-top
  aria-label="Volver arriba"
  data-i18n-attr="aria-label:footer.to_top"
>
  <Icon name="arrow-up" />
</button>
