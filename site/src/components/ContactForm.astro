---
import Icon from "./Icon.astro";

const fields: {
  id: string;
  icon: string;
  label: string;
  ph: string;
  type: "text" | "tel" | "email";
  ac: string;
}[] = [
  { id: "name", icon: "user", label: "Nombre completo", ph: "Nombre", type: "text", ac: "name" },
  { id: "phone", icon: "phone", label: "Celular", ph: "313 409 6201", type: "tel", ac: "tel" },
  {
    id: "email",
    icon: "mail",
    label: "Correo electrónico",
    ph: "example@gmail.com",
    type: "email",
    ac: "email",
  },
  { id: "country", icon: "globe", label: "País", ph: "Tu país", type: "text", ac: "country-name" },
  {
    id: "city",
    icon: "pin",
    label: "Ciudad",
    ph: "Tu ciudad",
    type: "text",
    ac: "address-level2",
  },
  { id: "subject", icon: "tag", label: "Asunto", ph: "Asunto", type: "text", ac: "off" },
];
---

<section id="contact" class="section">
  <div class="container">
    <div class="section__head section__head--center reveal">
      <p class="section__kicker">Contacto</p>
      <h2 class="section__title" data-i18n="contact.title" data-i18n-html>
        Contacta <span>Conmigo</span>
      </h2>
      <p class="section__lead" data-i18n="contact.subtitle">
        ¿Tienes una idea, un proyecto en mente o solo quieres conectar? Escríbeme, te leo con gusto.
      </p>
    </div>

    <div class="contact__grid">
      <aside class="contact__aside reveal">
        <a class="contact__method" href="mailto:ignas.manuel@hotmail.com">
          <span class="icon-badge"><Icon name="mail" /></span>
          <div>
            <strong>ignas.manuel@hotmail.com</strong>
            <span>Correo</span>
          </div>
        </a>
        <a
          class="contact__method"
          href="https://wa.me/573134096201?text=Hola%20Manuel%2C%20vi%20tu%20portafolio%20y%20quiero%20consultarte%20un%20proyecto."
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon-badge contact__method--wa"><Icon name="whatsapp" /></span>
          <div>
            <strong>+57 313 409 6201</strong>
            <span>WhatsApp</span>
          </div>
        </a>
        <a class="contact__method" href="tel:+573134096201">
          <span class="icon-badge"><Icon name="phone" /></span>
          <div>
            <strong>+57 313 409 6201</strong>
            <span>Llamada</span>
          </div>
        </a>
        <a
          class="contact__method"
          href="https://www.linkedin.com/in/manuel-causil-a48454267/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon-badge"><Icon name="linkedin" /></span>
          <div>
            <strong>Manuel Causil</strong>
            <span>LinkedIn</span>
          </div>
        </a>
        <div class="contact__method">
          <span class="icon-badge icon-badge--gold"><Icon name="pin" /></span>
          <div>
            <strong>Yopal, Casanare · Colombia</strong>
            <span>Ubicación</span>
          </div>
        </div>
      </aside>

      <form
        id="contact-form"
        class="form reveal"
        style="--stagger:1"
        action="https://formsubmit.co/b1db0bfe8125cc8c4b0d3be46bb2203a"
        method="POST"
        novalidate
      >
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" hidden />
        <input
          type="hidden"
          name="_subject"
          value="Nuevo mensaje desde el portafolio"
          data-i18n-attr="value:contact.form.mail_subject"
        />
        <input type="hidden" name="_template" value="table" />
        <input
          type="hidden"
          name="_autoresponse"
          value="¡Hola! Gracias por escribirme. He recibido tu mensaje y te responderé pronto."
          data-i18n-attr="value:contact.form.autoresponse"
        />

        <div class="form__grid">
          {
            fields.map((f) => (
              <div class="field">
                <label for={f.id}>
                  <Icon name={f.icon} />
                  <span data-i18n={`contact.form.${f.id}_label`}>{f.label}</span>
                </label>
                <input
                  id={f.id}
                  name={f.id}
                  type={f.type}
                  placeholder={f.ph}
                  autocomplete={f.ac}
                  required
                  aria-describedby={`err-${f.id}`}
                  data-i18n-attr={`placeholder:contact.form.${f.id}_ph`}
                />
                <p class="field__error" id={`err-${f.id}`} role="alert" aria-live="polite" />
              </div>
            ))
          }

          <div class="field field--full">
            <label for="message">
              <Icon name="message" />
              <span>Mensaje</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              maxlength="1000"
              placeholder="Tu mensaje (opcional)"
              aria-describedby="err-message"
              data-i18n-attr="placeholder:contact.form.message_ph"></textarea>
            <p class="field__error" id="err-message" role="alert" aria-live="polite"></p>
          </div>
        </div>

        <div class="form__foot">
          <button type="submit" class="btn btn--primary">
            <Icon name="send" />
            <span data-i18n="contact.form.submit">Enviar</span>
          </button>
          <p class="form__status" id="form-status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>
